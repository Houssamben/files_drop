# -*- coding: utf-8 -*-
import dataiku
import pandas as pd

if __name__ == "__main__":

    COUNTRIES = ["fr", "it", "gb", "es", "de", "nl", "be"]

    dfs = [
        dataiku.Dataset(f"entrep_{c}_monthly_v1").get_dataframe(columns=["enpers", "enlbre"])
        for c in COUNTRIES
    ]

    raw_lookup_df = (
        pd.concat(dfs, ignore_index=True)
        .drop_duplicates()
        .rename(columns={
            "enpers": "id_local_3rd_party",
            "enlbre": "social_reason_local_local_3rd_party"
        })
    )

    dataiku.Dataset("RAW_social_reason_lookup").write_with_schema(raw_lookup_df)
